// Takatak MEV: Prisma schema
//
// Sales recording system (SEV) for Revenu Québec WEB-SRM (MEV-WEB), restaurant sector.
// NOT certified. Field and code names follow Revenu Québec's public pages ("PROVEN");
// anything marked SPEC must be confirmed against SW-73 / SW-77 once the partner documents arrive.
//
// Money is stored in integer cents everywhere. Identity values (NEQ, GST/QST numbers, file number,
// authorization code) live only in this database, never in git, tests or logs.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

/// sectActi.abrvt. RBC = restaurant, bar, café (PROVEN). TRP = paid passenger transport (SPEC, unused).
enum SectorType {
  RBC
  TRP
}

enum DeviceType {
  CASH_REGISTER
  TABLET
  MOBILE
  SERVER
}

enum UserRole {
  ADMIN
  MANAGER
  CASHIER
  SYSTEM
}

enum CertificateType {
  SEV     // the SEV device certificate (our key pair, issued by MEV-WEB through CRT)
  MEV_WEB // MEV-WEB's own certificate returned with the CRT answer
}

/// ENVIRN header values (PROVEN names DEV / ESSAI / PROD) plus our local simulator.
enum MevEnvironment {
  SIMULATOR
  DEV
  ESSAI
  PROD
}

/// typTrans (PROVEN). Credit notes are RFER with negative amounts.
enum TransactionType {
  ADDI // addition (facture originale)
  ESTM // estimation
  RFER // reçu de fermeture ou note de crédit
  SOUM // soumission
}

/// Internal document kind (drives the receipt mentions).
enum DocumentKind {
  RECEIPT
  CREDIT_NOTE
  ADDITION
  ESTIMATE
  QUOTE
}

enum TransactionStatus {
  ISSUED
  CREDITED
  PARTIALLY_CREDITED
}

enum MevStatus {
  PENDING         // signed and stored, not sent yet
  ACCEPTED        // MEV-WEB answered without errors
  OFFLINE_PENDING // MEV-WEB unreachable: signed locally, waits in the offline queue (48 h limit)
  RETRY_BATCH     // MEV-WEB said "not sent" (codRetour ending in 0, 1 or 5): resent with the next batch
  REJECTED        // MEV-WEB refused it (other codes): needs a human
}

/// modPai (PROVEN public names; codes from the 2022 sample, confirm in SW-73).
/// Public modes still without a confirmed code: coupon, programme de fidélisation, cryptomonnaie,
/// portefeuille électronique, transfert de fonds, porté au compte (SPEC, not offered yet).
enum PaymentMode {
  ARG // argent comptant
  CHQ // chèque
  CRE // carte de crédit
  DEB // carte de débit
  CPR // certificat-cadeau / carte prépayée
  MIX // paiement mixte
  AUT // autre
  INC // inconnu (bar permit only)
  AUC // aucun paiement
}

/// modImpr (PROVEN public modes).
enum PrintMode {
  FAC // facturation
  RPR // reproduction
  DUP // duplicata (copie du commerçant)
  ANN // annulation (abandoned transaction)
  PSP // parti sans payer
}

/// formImpr (PROVEN public supports).
enum PrintFormat {
  PAP // papier
  ELE // électronique
  PEL // papier et électronique
  NON // non imprimé
}

/// modTrans (PROVEN): opérationnel or formation.
enum TransactionMode {
  OPE
  FOR
}

/// sectActi.typServ (PROVEN values).
enum ServiceType {
  CMP // service au comptoir
  LVR // livraison par l'exploitant
  LVT // commande par une plateforme numérique
  TBL // service aux tables
}

enum ItemTax {
  FP  // TPS + TVQ
  F   // TPS only
  P   // TVQ only
  NON // not taxable
}

enum ItemActivity {
  RES // restaurant
  BAR // bar (permit required)
  NON // supply not covered by the measures
}

enum ModificationType {
  ADD_ITEM
  REMOVE_ITEM
  MODIFY_PRICE
  CREDIT_NOTE
  REPRINT
}

enum ReportType {
  RUT // rapport de l'utilisateur
}

enum ConventionType {
  THIRD_PARTY
}

enum AuditEventType {
  TRANSACTION_CREATED
  TRANSACTION_MODIFIED
  TRANSACTION_CREDITED
  TRANSACTION_REPRINTED
  CERTIFICATE_REQUESTED
  CERTIFICATE_RECEIVED
  CERTIFICATE_REVOKED
  USER_REGISTERED
  USER_REPORT_GENERATED
  OFFLINE_MODE_ACTIVATED
  OFFLINE_MODE_DEACTIVATED
  OFFLINE_SYNC
  OFFLINE_DEADLINE_WARNING
  BATCH_SUBMITTED
  MEV_ERROR
  AUTH_LOGIN
  AUTH_LOGIN_FAILED
  SETTINGS_CHANGED
  INTEGRATION_SALE
  INTEGRATION_REJECTED
  SYSTEM_ERROR
}

enum LogSeverity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum MevRequestType {
  CRT
  UTL
  TRX
  DOC
}

enum QueueStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ExternalSaleKind {
  SALE
  CREDIT_NOTE
  PRINT
}

enum ExternalSaleStatus {
  PROCESSING
  DONE
}

// ─── Models ──────────────────────────────────────────────────────────────────

/// The legal business. One QCMEV instance can serve several.
model Operator {
  id          String         @id @default(uuid())
  name        String
  neq         String         @unique
  noTPS       String
  noTVQ       String
  sector      SectorType     @default(RBC)
  address     String?
  city        String?
  province    String?        @default("QC")
  postalCode  String?
  environment MevEnvironment @default(SIMULATOR)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  devices               Device[]
  certificates          Certificate[]
  users                 SEVUser[]
  transactions          Transaction[]
  auditLogs             AuditLog[]
  mevRequestLogs        MevRequestLog[]
  userReports           UserReport[]
  thirdPartyConventions ThirdPartyConvention[]
  locationMappings      LocationMapping[]
}

/// One SEV device. In remote-server mode (APPRLINIT=SRV) there is one per establishment.
model Device {
  id                   String     @id @default(uuid())
  operatorId           String
  serialNumber         String     @unique
  deviceType           DeviceType @default(SERVER)
  description          String?
  /// noDossFO: the establishment's mandatory-billing file number. Private.
  fileNumber           String?
  /// Authorization code for CRT, AES-256-GCM encrypted. Never returned by the API.
  authorizationCodeEnc String?    @db.Text
  /// IDAPPRL assigned by MEV-WEB in the CRT answer.
  mevDeviceId          String?
  offlineMode          Boolean    @default(false)
  offlineSince         DateTime?
  lastSyncAt           DateTime?
  /// Global sequence of transactions signed on this device (drives the signature chain).
  lastSeq              Int        @default(0)
  isActive             Boolean    @default(true)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt

  operator         Operator          @relation(fields: [operatorId], references: [id])
  transactions     Transaction[]
  offlineQueue     OfflineQueue[]
  certificates     Certificate[]
  locationMappings LocationMapping[]

  @@index([operatorId])
}

model SEVUser {
  id              String    @id @default(uuid())
  operatorId      String
  username        String    @unique
  /// bcrypt hash; null for system users, which cannot log in.
  passwordHash    String?
  firstName       String
  lastName        String
  role            UserRole  @default(CASHIER)
  /// nomUtil registered with MEV-WEB through UTL.
  mevUserName     String?
  mevRegisteredAt DateTime?
  mevUserId       String?
  /// Link to a user of an integration, e.g. "foodhub:<staff id>" or "foodhub:FOODHUB-AUTO".
  externalId      String?
  isActive        Boolean   @default(true)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  operator     Operator      @relation(fields: [operatorId], references: [id])
  transactions Transaction[]

  @@unique([operatorId, externalId])
  @@index([operatorId])
}

model Certificate {
  id                  String          @id @default(uuid())
  operatorId          String
  deviceId            String?
  type                CertificateType
  serialNumber        String?
  subject             String?
  issuer              String?
  thumbprint          String?
  validFrom           DateTime?
  validUntil          DateTime?
  pemCertificate      String?         @db.Text
  /// AES-256-GCM encrypted PKCS#8 private key (SEV certificates only).
  encryptedPrivateKey String?         @db.Text
  csrPem              String?         @db.Text
  isActive            Boolean         @default(true)
  revokedAt           DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  operator Operator @relation(fields: [operatorId], references: [id])
  device   Device?  @relation(fields: [deviceId], references: [id])

  @@index([operatorId])
  @@index([deviceId])
}

model Transaction {
  id                   String            @id @default(uuid())
  operatorId           String
  deviceId             String
  userId               String
  /// Per device, per civil day (America/Montreal), starting at 1.
  transactionNumber    Int
  /// noTrans as transmitted.
  noTrans              String
  civilDate            String
  /// datTrans AAAAMMJJhhmmss, local time.
  datTrans             String
  /// utc offset of datTrans, -04:00 or -05:00.
  utcOffset            String
  /// Order of this transaction in the device's signature chain.
  deviceSeq            Int
  transactionType      TransactionType
  documentKind         DocumentKind
  transactionMode      TransactionMode   @default(OPE)
  printMode            PrintMode         @default(FAC)
  printFormat          PrintFormat       @default(PAP)
  serviceType          ServiceType?
  sector               SectorType        @default(RBC)
  tableNumber          String?
  numberOfCovers       Int?
  ecommerce            Boolean           @default(false)
  paymentMode          PaymentMode
  subtotalCents        Int
  tpsCents             Int
  tvqCents             Int
  totalCents           Int
  tipCents             Int?
  adjustCents          Int?
  amountDueCents       Int?
  status               TransactionStatus @default(ISSUED)
  mevStatus            MevStatus         @default(PENDING)
  /// signa.actu: ECDSA P-256 / SHA-256 signature, 88 base64 characters.
  signature            String
  /// signa.preced: previous signature on this device (88 "=" for the first one).
  previousSignature    String
  /// signa.datActu
  signedAt             String
  /// Internal SHA-256 audit chain. Never transmitted.
  hashChain            String
  /// The transaction part of the request (identity values excluded), for resend and audit.
  requestJson          Json
  mevTransactionNumber String?
  mevProcessedAt       String?
  mevSubmittedAt       DateTime?
  mevResponse          Json?
  mevErrors            Json?
  qrContent            String?           @db.Text
  mentions             Json?
  relatedTransactionId String?
  /// Free text shown on the receipt (e.g. the platform order number).
  externalRef          String?
  occurredAt           DateTime?
  invoicedAt           DateTime          @default(now())
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  operator      Operator                  @relation(fields: [operatorId], references: [id])
  device        Device                    @relation(fields: [deviceId], references: [id])
  user          SEVUser                   @relation(fields: [userId], references: [id])
  related       Transaction?              @relation("TransactionReference", fields: [relatedTransactionId], references: [id])
  referencedBy  Transaction[]             @relation("TransactionReference")
  items         TransactionItem[]
  modifications TransactionModification[]
  queueEntries  OfflineQueue[]

  @@unique([deviceId, civilDate, transactionNumber])
  @@unique([deviceId, deviceSeq])
  @@index([operatorId])
  @@index([civilDate])
  @@index([mevStatus])
}

model TransactionItem {
  id             String       @id @default(uuid())
  transactionId  String
  ref            String?
  description    String
  /// Decimal string, e.g. "1" or "0.5".
  quantity       String
  unitPriceCents Int
  totalCents     Int
  tax            ItemTax      @default(FP)
  activity       ItemActivity @default(RES)
  isModifier     Boolean      @default(false)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@index([transactionId])
}

/// Every change after invoicing is a real transaction; this table links it to the reason.
model TransactionModification {
  id                  String           @id @default(uuid())
  transactionId       String
  resultTransactionId String?
  modificationType    ModificationType
  description         String
  previousValue       Json?
  newValue            Json?
  reason              String?
  performedByUserId   String?
  performedAt         DateTime         @default(now())

  transaction Transaction @relation(fields: [transactionId], references: [id])

  @@index([transactionId])
}

model UserReport {
  id                String     @id @default(uuid())
  operatorId        String
  reportType        ReportType @default(RUT)
  reportYear        Int
  totalSalesCents   Int
  totalTpsCents     Int
  totalTvqCents     Int
  totalTransactions Int
  previousYearJson  Json?
  mevReportNumber   String?
  mevStatus         MevStatus  @default(PENDING)
  submittedAt       DateTime?
  mevResponse       Json?
  createdAt         DateTime   @default(now())

  operator Operator @relation(fields: [operatorId], references: [id])

  @@index([operatorId])
}

model ThirdPartyConvention {
  id            String         @id @default(uuid())
  operatorId    String
  type          ConventionType
  partnerName   String
  partnerNEQ    String
  effectiveDate DateTime
  expiryDate    DateTime?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())

  operator Operator @relation(fields: [operatorId], references: [id])

  @@index([operatorId])
}

model AuditLog {
  id          String         @id @default(uuid())
  operatorId  String?
  eventType   AuditEventType
  severity    LogSeverity    @default(INFO)
  userId      String?
  deviceId    String?
  entityId    String?
  entityType  String?
  description String
  metadata    Json?
  ipAddress   String?
  createdAt   DateTime       @default(now())

  operator Operator? @relation(fields: [operatorId], references: [id])

  @@index([operatorId])
  @@index([eventType])
  @@index([createdAt])
}

/// Every call to MEV-WEB. Payloads are REDACTED before they are stored.
model MevRequestLog {
  id              String         @id @default(uuid())
  operatorId      String
  requestType     MevRequestType
  environment     MevEnvironment
  requestPayload  Json
  responsePayload Json?
  httpStatus      Int?
  mevErrorCode    String?
  duration        Int?
  success         Boolean?
  createdAt       DateTime       @default(now())

  operator Operator @relation(fields: [operatorId], references: [id])

  @@index([operatorId])
  @@index([requestType])
}

/// Transactions waiting for MEV-WEB. The request is rebuilt from the Transaction row.
model OfflineQueue {
  id            String         @id @default(uuid())
  deviceId      String
  transactionId String?
  requestType   MevRequestType @default(TRX)
  status        QueueStatus    @default(PENDING)
  attempts      Int            @default(0)
  lastAttemptAt DateTime?
  processedAt   DateTime?
  errorMessage  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  device      Device       @relation(fields: [deviceId], references: [id])
  transaction Transaction? @relation(fields: [transactionId], references: [id])

  @@index([deviceId])
  @@index([status])
}

// ─── Food Hub integration (contract foodhub.sale.v1) ─────────────────────────

/// Food Hub location (kitchen) → operator + SEV device. Kept in the database, never in git.
model LocationMapping {
  id            String   @id @default(uuid())
  integrationId String   @default("foodhub")
  tenantId      String
  locationId    String
  operatorId    String
  deviceId      String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  operator Operator @relation(fields: [operatorId], references: [id])
  device   Device   @relation(fields: [deviceId], references: [id])

  @@unique([tenantId, locationId])
}

/// Idempotency record: one row per saleKey / creditKey / printKey.
model ExternalSale {
  id            String             @id @default(uuid())
  tenantId      String
  key           String
  kind          ExternalSaleKind
  saleKey       String
  payloadHash   String
  transactionId String?
  status        ExternalSaleStatus @default(PROCESSING)
  httpStatus    Int?
  responseJson  Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([tenantId, key])
  @@index([tenantId, saleKey])
}

/// Replay guard: signed event ids seen in the last 24 h.
model IntegrationEvent {
  eventId    String   @id
  tenantId   String
  key        String
  bodyHash   String
  receivedAt DateTime @default(now())

  @@index([receivedAt])
}
