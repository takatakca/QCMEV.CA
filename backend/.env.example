# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://mev_user:mev_password@localhost:5432/takatak_mev?schema=public"

# ─── Authentication ───────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string-in-production"
JWT_EXPIRES_IN="8h"

# ─── MEV-WEB Environment ─────────────────────────────────────────────────────
# Options: SIMULATOR | DEVELOPMENT | TESTING | PRODUCTION
MEV_ENVIRONMENT="SIMULATOR"

# Your SEV software version (reported to Revenu Québec)
SEV_VERSION="1.0.0"

# Assigned during Revenu Québec partner certification (SW-11)
SEV_CERTIFICATION_CODE=""

# ─── Certificate Security ────────────────────────────────────────────────────
# 32-byte hex key for AES-256-CBC private key encryption
# Generate with: openssl rand -hex 32
PRIVATE_KEY_ENCRYPTION_KEY="generate-a-32-byte-hex-key-here"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3000
FRONTEND_URL="http://localhost:3001"

# ─── MEV-WEB Simulator (when MEV_ENVIRONMENT=SIMULATOR) ─────────────────────
SIMULATOR_URL="http://localhost:3002"
