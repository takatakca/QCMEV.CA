# Takatak MEV backend — environment. Copy to .env (never committed) and fill in.
# The server REFUSES TO START when a secret is missing, too short or looks like a placeholder.

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=

# ─── Secrets (generate each with: openssl rand -hex 32) ──────────────────────
JWT_SECRET=
JWT_EXPIRES_IN=8h
# 32 bytes: 64 hex characters or base64. Encrypts private keys and authorization codes (AES-256-GCM).
PRIVATE_KEY_ENCRYPTION_KEY=

# ─── Revenu Québec WEB-SRM environment ───────────────────────────────────────
# SIMULATOR (default, local test double) | DEV | ESSAI | PROD
MEV_ENVIRONMENT=SIMULATOR
# DEV / ESSAI / PROD only — values from the partner documents (SW-73); no URL is guessed by the code.
MEV_WEB_BASE_URL=
MEV_QR_BASE_URL=
# SEV identification headers (IDSEV, IDVERSI, CODCERTIF, IDPARTN, VERSI, VERSIPARN), given by Revenu Québec.
# Required outside the simulator; typed by the owner, never committed.
MEV_IDSEV=
MEV_IDVERSI=
MEV_CODCERTIF=
MEV_IDPARTN=
MEV_VERSI=
MEV_VERSIPARN=
# ESSAI only: the test case number being run (CASESSAI header).
MEV_CASESSAI=
# PROD is refused unless this is set (the product's certification number).
QCMEV_CERTIFICATION_NUMBER=
MEV_TIMEOUT_MS=10000
MEV_OFFLINE_FLUSH_SECONDS=30
# Simulator only: where its throwaway CA and state are kept (default: OS temp folder).
MEV_SIMULATOR_STATE_DIR=

# ─── Food Hub integration (OFF by default) ───────────────────────────────────
QCMEV_FOODHUB_ENABLED=false
# Same value as FOODHUB_MEV_SECRET in Food Hub. Two values may be active during a rotation.
QCMEV_FOODHUB_SECRET=
QCMEV_FOODHUB_SECRET_PREVIOUS=
# X-Integration-Id values accepted (Food Hub's signContract sends "on2go_hub").
QCMEV_FOODHUB_INTEGRATION_IDS=foodhub,on2go_hub

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=3001
LOG_LEVEL=log
FRONTEND_URL=http://localhost:3000

# ─── docker-compose only ─────────────────────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=qcmev
