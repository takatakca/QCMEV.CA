# ═══════════════════════════════════════════════════════════════
# Takatak MEV — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ═══════════════════════════════════════════════════════════════

# ─── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://takatak:CHANGE_ME@localhost:5432/qcmev

# ─── Auth ──────────────────────────────────────────────────────
# Minimum 32 random characters — use: openssl rand -hex 32
JWT_SECRET=CHANGE-THIS-IN-PRODUCTION-USE-A-LONG-RANDOM-STRING

# ─── Certificate encryption ────────────────────────────────────
# EXACTLY 32 characters — used for AES-256-CBC key encryption
PRIVATE_KEY_ENCRYPTION_KEY=CHANGE-THIS-32-CHAR-KEY-IN-PROD!!

# ─── MEV-WEB environment ───────────────────────────────────────
# SIMULATOR  → built-in simulator (served by the backend at /api/mev-simulator, no RQ credentials needed)
# DEVELOPMENT → Revenu Québec dev/sandbox
# TESTING     → Revenu Québec testing (SW-77 certification runs here)
# PRODUCTION  → live Revenu Québec production
MEV_ENVIRONMENT=SIMULATOR

# ─── CORS ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000

# ─── Node ──────────────────────────────────────────────────────
NODE_ENV=development

# ─── Frontend (prefix NEXT_PUBLIC_ exposes to browser) ─────────
NEXT_PUBLIC_API_URL=http://localhost:3001

# ─── Certificate lifecycle ──────────────────────────────────────────────────
# Nightly job (03:00 Québec time) renews certificates expiring within N days
CERT_RENEWAL_DAYS=30
# Simulator only: validity of certificates it issues (set low, e.g. 10, to test renewal)
SIMULATOR_CERT_VALIDITY_DAYS=365
